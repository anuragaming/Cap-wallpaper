    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/btn_floating_capture"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_floating_button"
